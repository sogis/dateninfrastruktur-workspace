#!/usr/bin/env bash

if [[ $# != 1 || ( $1 != clone && $1 != status ) ]]; then
    printf 'Aufruf: %s {clone|status}\n' "${0##*/}" >&2
    exit 2
fi

cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" || exit 1

result=0
while IFS= read -r url || [[ -n $url ]]; do
    case $url in
        ''|\#*) continue ;;
    esac

    name=${url##*/}
    name=${name%.git}
    if [[ -z $name || $name == . || $name == .. ]]; then
        printf 'Ungültiger Repositoryname in repositories.txt: %s\n' "$url" >&2
        result=1
    elif [[ -e $name || -L $name ]]; then
        if [[ -L $name || ! -d $name ||
              $(git -C "./$name" rev-parse --show-toplevel 2>/dev/null) != "$PWD/$name" ]]; then
            printf '%s: Zielpfad ist belegt und kein eigener Checkout\n' "$name" >&2
            result=1
        elif [[ $1 == status ]]; then
            printf '%s: vorhanden\n' "$name"
            git --no-optional-locks -C "./$name" status --short --branch || result=1
        else
            printf '%s: bereits vorhanden, übersprungen\n' "$name"
        fi
    elif [[ $1 == clone ]]; then
        printf '%s: klone\n' "$name"
        git clone -- "$url" "./$name" || result=1
    else
        printf '%s: fehlt\n' "$name"
    fi
done < repositories.txt || exit 1

exit "$result"
