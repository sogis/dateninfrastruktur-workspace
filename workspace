#!/usr/bin/env python3
"""One entry point for workspace management."""
import argparse
import json
from pathlib import Path
import sys

from tooling.review.runner import review
from tooling.workspace.gitops import clone_missing, inspect, source_set, sync, verify_root, write_atomic
from tooling.workspace.inventory import WorkspaceError, load, relative


def main():
    root = Path(__file__).resolve().parent
    cli = argparse.ArgumentParser(description=__doc__)
    commands = cli.add_subparsers(dest='command',required=True)
    for name in ('status','bootstrap','snapshot'):
        command=commands.add_parser(name)
        command.add_argument('--profile',choices=('core','extended'),default='core')
        if name=='snapshot':
            command.add_argument('--output',type=Path,required=True)
            command.add_argument('--exclude-untracked',action='store_true')
    sync_args=commands.add_parser('sync')
    sync_args.add_argument('--repo',action='append',required=True)
    commands.add_parser('verify')
    review_args=commands.add_parser('review')
    review_args.add_argument('--task',type=Path,required=True)
    review_args.add_argument('--phase',required=True)
    review_args.add_argument('--exclude-untracked',action='store_true')
    args=cli.parse_args()
    if sys.version_info<(3,9):
        raise WorkspaceError('Python 3.9 oder neuer erforderlich')
    inventory=load(root/'repositories.json')
    if args.command=='verify':
        verify_root(root,inventory)
        print('Workspace-Grenzen geprüft')
        return 0
    if args.command=='review':
        run=review(root,inventory,args.task,args.phase,exclude_untracked=args.exclude_untracked)
        print(f'ABGENOMMEN {args.phase} {run.name}')
        return 0
    selected=inventory.select(args.profile) if hasattr(args,'profile') else inventory.select(ids=tuple(args.repo))
    if args.command=='snapshot':
        dest=args.output.absolute()
        allowed=root/'.runtime'
        if not dest.is_relative_to(allowed) or dest.resolve()!=dest:
            raise WorkspaceError('Snapshotziel muss innerhalb der nicht verlinkten .runtime liegen')
        relative(dest.relative_to(allowed).as_posix())
        write_atomic(dest,source_set(root,inventory,selected,allow_untracked=args.exclude_untracked))
        print(dest)
        return 0
    errors=False
    for entry in selected:
        try:
            if args.command=='status':
                detail=inspect(root,entry)
                print(json.dumps(detail,ensure_ascii=True))
                errors |= detail['state']!='PRESENT'
            else:
                operation=clone_missing if args.command=='bootstrap' else sync
                print(f'{entry.id} {operation(root,entry)}')
        except (OSError,WorkspaceError) as error:
            errors=True
            print(f'{entry.id} {error}',file=sys.stderr)
    return int(errors)


if __name__=='__main__':
    try:
        sys.exit(main())
    except (OSError,ValueError,KeyError,TypeError) as error:
        print(f'Workspace: {error}',file=sys.stderr)
        sys.exit(1)
